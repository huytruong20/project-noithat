# =============================================================================
# BIẾN MÔI TRƯỜNG — chép file này thành .env.local rồi điền giá trị thật
#
#   cp .env.example .env.local
#
# .env.local KHÔNG được đưa lên kho mã nguồn (đã chặn sẵn trong .gitignore).
# Khi deploy lên Vercel thì khai lại từng biến ở mục Environment Variables.
# =============================================================================

# --- Cơ sở dữ liệu -----------------------------------------------------------
# Lấy ở neon.tech (miễn phí) hoặc supabase.com, dạng:
#   postgresql://user:mat-khau@may-chu/ten-db?sslmode=require
#
# ĐỂ TRỐNG cũng chạy được: web sẽ ghi dữ liệu ra thư mục .data/ trên máy.
# Nhưng khi deploy lên Vercel BẮT BUỘC phải có, vì nơi đó không cho ghi file
# và dữ liệu sẽ mất sau mỗi lần deploy.
DATABASE_URL=

# --- Khoá ký phiên đăng nhập -------------------------------------------------
# Sinh bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Đổi khoá này là toàn bộ khách đang đăng nhập bị văng ra, nên đặt một lần rồi
# giữ nguyên. Không đặt thì khoá nằm trong .data/ và sẽ mất khi deploy.
AUTH_SECRET=

# --- Tài khoản quản trị đầu tiên ---------------------------------------------
# Chỉ dùng ở lần chạy đầu tiên khi bảng tài khoản còn rỗng.
# Không đặt thì mặc định là admin@noithatht.vn / admin123456 — ĐỔI NGAY.
ADMIN_EMAIL=
ADMIN_MAT_KHAU=

# --- Tên miền thật -----------------------------------------------------------
# Dùng cho sitemap, thẻ canonical và ảnh xem trước khi chia sẻ mạng xã hội.
NEXT_PUBLIC_SITE_URL=https://noithatht.vn
